# Agent Office — Environment Variables
# Copy this file to .env and fill in your values.
# .env is gitignored and should never be committed.

# GitHub Personal Access Token (required)
# Needs: repo, issues, workflow scopes
GITHUB_TOKEN=

# Slack webhook URL for AFK notification mode (optional)
SLACK_WEBHOOK_URL=

# Twilio credentials for SMS notifications in AFK mode (optional)
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=
TWILIO_TO=
